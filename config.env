# 内核源码地址（小米官方针对K30开源的内核库）
KERNEL_SOURCE=https://github.com/MiCode/Xiaomi_Kernel_OpenSource

# 内核源码分支（phoenix对应的Android 11/R开源分支）
KERNEL_SOURCE_BRANCH=phoenix-r-oss

# 内核编译配置（K30 4G的官方defconfig路径）
KERNEL_CONFIG=vendor/phoenix_defconfig

# 内核打包名字，自定义，支持英文数字
KERNEL_ZIP_NAME=phoenix_docker_kernel_4.14

# 是否开启kvm
# 手机跑家庭服务器用不到，填false
ENABLE_KVM=false

# 是否开启lxc-docker，必须为true
ENABLE_LXC_DOCKER=true

# 选择要打包的内核镜像文件
# 骁龙730G/SM7150填 Image.gz-dtb 兼容性最好
KERNEL_IMAGE_NAME=Image.gz-dtb

# 是否需要LLVM=1 LLVM_IAS=1参数
# 4.14内核需要LLVM Clang编译，填 y
LLVM_CONFIG=n

# 是否需要切换python2，不需要，填false
SWITCH_PYTHON=false

# 是否需要dtbo，使用AnyKernel3刷入时不需要，填false
NEED_DTBO=false

# KernelSU Root支持
# 如果你想用更纯净的内置内核Root，设为 true；
# 如果你打算进Recovery刷 Magisk，保持 false 即可（更不易出错）
ENABLE_KERNELSU=false
KERNELSU_TAG=main
